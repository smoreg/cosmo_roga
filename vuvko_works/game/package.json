{
  "name": "derelict-extraction",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn-based hexagonal extraction tactics in a generated derelict.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:core": "vitest run --project core",
    "coverage": "vitest run --coverage",
    "lint:fast": "oxlint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "knip": "knip",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test",
    "design:bundle": "esbuild scripts/design-bundle.tsx --bundle --platform=node --format=esm --jsx=automatic --loader:.css=empty --loader:.json=json --outfile=.design-bundle.mjs --external:react --external:react-dom && node .design-bundle.mjs && rm .design-bundle.mjs",
    "deploy:itch": "npm run build && bash scripts/deploy-itch.sh",
    "assets:atlas": "python3 scripts/bake_tile_atlas.py",
    "sync:core": "node scripts/sync-geomorph-core.mjs",
    "assets:index": "node scripts/build-tile-index.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.5.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "oxlint": "^1.82.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
