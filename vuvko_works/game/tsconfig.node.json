{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "eslint.config.js",
    "eslint-rules/**/*.js"
  ]
}
