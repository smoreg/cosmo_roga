node_modules/
dist/
.DS_Store
*.log
build/
*.tsbuildinfo
*.zip
# Intermediate PCM from `npm run music`; only the .ogg next to it ships.
assets/audio/**/*.wav
# Raw model output from `npm run sfx`; only the .ogg beside it ships.
assets/audio/**/*.mp3

# Baked deck art. Third-party (CC BY-NC) and eleven megabytes, so it is built
# rather than carried — `node tools/deck/bake.mjs` in games/salvor, reading the
# downscaled set from vuvko_works. A tree without it draws the flat board,
# which is what this game had before the tiles and still a whole game.
games/salvor/public/deck/

# The music. Twenty-three megabytes of somebody else's work, one track of it
# under a personal grant — carried the way the deck art is, out of the tree and
# into the build. `games/salvor/public/audio/ATTRIBUTION.md` is the record.
games/salvor/public/audio/music/

# Sound effects, baked from the owner's WAVs by `node tools/sfx/bake.mjs`. Sixty
# kilobytes, so the size is not the reason — the reason is that the sources are
# not in this repository and what is committed is the recipe, the same
# arrangement the music and the deck art have.
games/salvor/public/audio/sfx/

# The upload itself.
games/salvor/*.zip
