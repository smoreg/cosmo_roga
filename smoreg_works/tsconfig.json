{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "vitest/globals", "node"],
    // The React view is the only JSX in the repo, and `tsc --build` reads this
    // file rather than the game's own, so the flag has to be here.
    "jsx": "react-jsx"
  },
  "include": ["packages/*/src", "packages/*/tests", "games/*/src", "games/*/tests", "scripts"],
  "exclude": ["games/_template", "**/node_modules", "**/dist"]
}
