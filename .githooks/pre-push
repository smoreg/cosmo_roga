#!/usr/bin/env bash
#
# Refuse a push that would put a broken vuvko_works on the remote.
#
# Only vuvko_works is gated. A push that touches nothing there — smoreg's half,
# the root README — runs no checks and costs nothing, because this is a shared
# repository and one person's hook is not the other person's problem.
#
# In a genuine emergency: SKIP_VUVKO_CHECKS=1 git push
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
game="$root/vuvko_works/game"

if [ "${SKIP_VUVKO_CHECKS:-}" = "1" ]; then
  echo "pre-push: vuvko_works checks skipped by request" >&2
  exit 0
fi

# Which commits are actually going up? stdin gives "<local ref> <local sha>
# <remote ref> <remote sha>" per ref being pushed.
touches_vuvko=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
    changed="$(git diff --name-only "$(git merge-base "$local_sha" HEAD 2>/dev/null || echo "$local_sha")" "$local_sha" 2>/dev/null)"
  else
    range="$remote_sha..$local_sha"
    changed="$(git diff --name-only "$range" 2>/dev/null)"
  fi

  if printf '%s\n' "$changed" | grep -q '^vuvko_works/'; then
    touches_vuvko=1
  fi
done

if [ "$touches_vuvko" -eq 0 ]; then
  exit 0
fi

if [ ! -d "$game/node_modules" ]; then
  cat >&2 <<'MISSING'
pre-push: vuvko_works/game has no node_modules, so its checks cannot run.

    cd vuvko_works/game && npm ci

Refusing the push rather than letting it through unchecked.
MISSING
  exit 1
fi

echo "pre-push: checking vuvko_works/game" >&2
cd "$game" || exit 1

fail() {
  echo >&2
  echo "pre-push: $1 failed — push refused." >&2
  echo "Fix it, or SKIP_VUVKO_CHECKS=1 git push if you truly must." >&2
  exit 1
}

npx --no-install prettier --check . >/dev/null 2>&1 || fail "formatting (npm run format)"
npx --no-install oxlint --deny-warnings >/dev/null 2>&1 || fail "oxlint (npm run lint:fast)"
npx --no-install tsc -b --noEmit >/dev/null 2>&1 || fail "typecheck (npm run typecheck)"
npx --no-install eslint . >/dev/null 2>&1 || fail "lint (npm run lint)"
npx --no-install vitest run >/dev/null 2>&1 || fail "tests (npm test)"

echo "pre-push: vuvko_works/game is clean" >&2
exit 0
